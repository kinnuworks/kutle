{
  "name": "secp256k1_port",
  "version": "0.7.1",
  "description": "Builds the bitcoin-core/secp256k1 submodule (lib/secp256k1) with the recovery and ECDH modules",
  "frameworks": "*",
  "platforms": "*",
  "build": {
    "srcDir": "../secp256k1/src",
    "srcFilter": ["-<*>", "+<secp256k1.c>", "+<precomputed_ecmult.c>", "+<precomputed_ecmult_gen.c>"],
    "includeDir": "../secp256k1/include",
    "flags": ["-std=c99", "-Wno-unused-function", "-DENABLE_MODULE_RECOVERY=1", "-DENABLE_MODULE_ECDH=1", "-DECMULT_WINDOW_SIZE=4", "-DCOMB_BLOCKS=2", "-DCOMB_TEETH=5"]
  }
}
